@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageStyle rectangle

skinparam actor {
  BackgroundColor #F8F9FA
  BorderColor #343A40
}
skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #0D6EFD
}
skinparam ArrowColor #2F55D4

left to right direction

actor "Pelamar" as Pelamar
actor "HRD / Admin" as HRD

rectangle "Sistem E-Recruitment Klinik Keluarga" {
  
  package "Autentikasi & Akun" {
    usecase "UC-01: Registrasi Akun" as UC01
    usecase "UC-01a: Verifikasi Email" as UC01a
    usecase "UC-02: Login ke Sistem" as UC02 #E0F2FE
  }

  package "Portal Pelamar" {
    usecase "UC-03: Kelola Profil & Dokumen" as UC03
    usecase "UC-04: Melihat Lowongan Pekerjaan" as UC04
    usecase "UC-05: Melamar Pekerjaan" as UC05
    usecase "UC-06: Memantau Status Lamaran" as UC06
  }

  package "Portal HRD / Admin" {
    usecase "UC-07: Kelola Lowongan & Batch" as UC07 #FEF3E2
    usecase "UC-08: Meninjau Lamaran & Data Pelamar" as UC08 #FEF3E2
    usecase "UC-09: Menjadwalkan Wawancara" as UC09 #FEF3E2
  }
}

' Relasi Aktor Pelamar
Pelamar -- UC01
Pelamar -- UC02
Pelamar -- UC03
Pelamar -- UC04
Pelamar -- UC06

' Relasi Aktor HRD
HRD -- UC02
HRD -- UC07
HRD -- UC08
HRD -- UC09

' Relasi Include & Extend
UC01 ..> UC01a : <<include>>
UC02 ..> UC01 : <<extend>>
UC05 ..> UC04 : <<extend>>
UC05 ..> UC03 : <<include>>
UC09 ..> UC08 : <<extend>>

@enduml
