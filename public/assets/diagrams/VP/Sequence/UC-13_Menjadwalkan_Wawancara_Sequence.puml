@startuml UC-13_Menjadwalkan_Wawancara_Sequence
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam sequenceParticipantBorderThickness 1
skinparam sequenceLifeLineBorderColor #000000
skinparam sequenceLifeLineBorderThickness 1
skinparam sequenceLifeLineBackgroundColor #7ACFF5
skinparam sequenceGroupBorderThickness 1
skinparam sequenceGroupFontSize 10
skinparam sequenceGroupHeaderFontColor #000000
skinparam sequenceGroupFontColor #000000
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 160
skinparam pageMargin 10
hide footbox

skinparam participant {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 10
}

skinparam boundary {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam control {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam entity {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

' Deklarasi Lifeline
actor "HRD / Admin" as HRD
boundary "SchedulePage" as Page
control "ScheduleController" as Controller
entity "ScheduleModel" as Model

' Group sd View/Read: Akses Daftar Agenda Wawancara
group sd View/Read
  HRD -> Page : 1. Akses menu jadwal wawancara
  activate HRD
  activate Page
  Page -> Controller : 1.1 datatables(request)
  activate Controller
  Controller -> Model : 1.1.1 with(['batch', 'job', 'candidate', 'apply'])->orderBy('start_datetime', 'DESC')->get()
  activate Model
  Model --> Controller : 1.1.2 Result data agenda wawancara
  deactivate Model
  Controller --> Page : 1.2 Return JSON DataTables data
  deactivate Controller
  Page --> HRD : 1.3 Tampilkan tabel jadwal wawancara terdaftar
  deactivate Page
  deactivate HRD
end

' Group sd Create: Buat Jadwal & Kirim Undangan Wawancara
group sd Create
  HRD -> Page : 2. Klik "Jadwalkan Wawancara", pilih pelamar, isi tanggal, tipe & link/lokasi, klik "Simpan"
  activate HRD
  activate Page
  Page -> Controller : 2.1 store(request)
  activate Controller
  Controller -> Controller : 2.1.1 validatedScheduleInterviewData(request)
  Controller -> Model : 2.1.2 create(data)
  activate Model
  Model --> Controller : 2.1.3 Result (interview)
  deactivate Model

  alt <font color=black>[Sukses: Jadwal Valid & Pelamar Terverifikasi]</font>
    Controller -> Controller : 2.2 candidate->notify(new InterviewInvitationNotification)
    Controller --> Page : 2.3 Return redirect route("admin.schedule-interviews.index") dengan pesan sukses
    Page --> HRD : 2.4 Tampilkan notifikasi "Jadwal Wawancara Berhasil Dibuat & Undangan Terkirim"
  else <font color=black>[Gagal: Data Pelamar Tidak Valid / Waktu Bentrok]</font>
    Controller --> Page : 2.5 Return redirect back dengan pesan error
    Page --> HRD : 2.6 Tampilkan pesan kesalahan konfigurasi jadwal wawancara
  end
  deactivate Controller
  deactivate Page
  deactivate HRD
end

@enduml
