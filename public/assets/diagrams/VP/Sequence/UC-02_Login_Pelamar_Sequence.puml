@startuml UC-02_Login_Pelamar_Sequence
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam sequenceParticipantBorderThickness 1
skinparam sequenceLifeLineBorderColor #000000
skinparam sequenceLifeLineBorderThickness 1
skinparam sequenceLifeLineBackgroundColor #7ACFF5
skinparam sequenceGroupBorderThickness 1
skinparam sequenceGroupFontSize 10
skinparam sequenceGroupHeaderFontColor #000000
skinparam sequenceGroupFontColor #000000
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 160
skinparam pageMargin 10
hide footbox

skinparam participant {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 10
}

skinparam boundary {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam control {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam entity {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

' Deklarasi Lifeline
actor "Pelamar" as Pelamar
boundary "LoginPage" as Page
control "AuthController" as Controller
entity "CandidateModel" as Model

' Group sd View/Read: Akses Halaman Login
group sd View/Read
  Pelamar -> Page : 1. Akses halaman login
  activate Pelamar
  activate Page
  Page -> Controller : 1.1 login()
  activate Controller
  Controller --> Page : 1.2 Return view("candidate.auth.login")
  deactivate Controller
  Page --> Pelamar : 1.3 Tampilkan formulir login
  deactivate Page
  deactivate Pelamar
end

' Group sd Process: Otentikasi Sesi Pelamar
group sd Process
  Pelamar -> Page : 2. Masukkan kredensial (email/username/telepon & password), klik "Masuk"
  activate Pelamar
  activate Page
  Page -> Controller : 2.1 process(request)
  activate Controller
  Controller -> Controller : 2.1.1 validate(request)
  Controller -> Model : 2.1.2 where(loginInput)->first()
  activate Model
  Model --> Controller : 2.1.3 Data akun kandidat
  deactivate Model

  alt <font color=black>[Sukses: Kredensial Valid & Email Terverifikasi]</font>
    Controller -> Controller : 2.2 Auth::guard("candidate")->login(candidate)
    Controller --> Page : 2.3 Return redirect route("candidate.home")
    Page --> Pelamar : 2.4 Tampilkan beranda portal karir pelamar
  else <font color=black>[Gagal: Kredensial Tidak Sesuai / Email Belum Aktif]</font>
    Controller --> Page : 2.5 Return redirect back dengan pesan error
    Page --> Pelamar : 2.6 Tampilkan notifikasi kesalahan login
  end
  deactivate Controller
  deactivate Page
  deactivate Pelamar
end

@enduml
