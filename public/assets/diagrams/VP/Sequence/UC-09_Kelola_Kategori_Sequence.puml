@startuml UC-09_Kelola_Kategori_Sequence
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam sequenceParticipantBorderThickness 1
skinparam sequenceLifeLineBorderColor #000000
skinparam sequenceLifeLineBorderThickness 1
skinparam sequenceLifeLineBackgroundColor #7ACFF5
skinparam sequenceGroupBorderThickness 1
skinparam sequenceGroupFontSize 10
skinparam sequenceGroupHeaderFontColor #000000
skinparam sequenceGroupFontColor #000000
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 160
skinparam pageMargin 10
hide footbox

skinparam participant {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 10
}

skinparam boundary {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam control {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam entity {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

' Deklarasi Lifeline
actor "HRD / Admin" as HRD
boundary "CategoryPage" as Page
control "CategoryController" as Controller
entity "CategoryModel" as Model

' Group sd View/Read: Akses Data Kategori
group sd View/Read
  HRD -> Page : 1. Akses menu kategori pekerjaan
  activate HRD
  activate Page
  Page -> Controller : 1.1 datatables()
  activate Controller
  Controller -> Model : 1.1.1 orderBy('id', 'ASC')->get()
  activate Model
  Model --> Controller : 1.1.2 Result data kategori
  deactivate Model
  Controller --> Page : 1.2 Return JSON DataTables data
  deactivate Controller
  Page --> HRD : 1.3 Tampilkan tabel daftar kategori pekerjaan
  deactivate Page
  deactivate HRD
end

' Group sd Create: Tambah Kategori Baru
group sd Create
  HRD -> Page : 2. Klik "Tambah Kategori", isi nama kategori & klik "Simpan"
  activate HRD
  activate Page
  Page -> Controller : 2.1 store(request)
  activate Controller
  Controller -> Model : 2.1.1 create(request->all())
  activate Model
  Model --> Controller : 2.1.2 Result (category)
  deactivate Model

  alt <font color=black>[Sukses: Kategori Tersimpan]</font>
    Controller --> Page : 2.2 Return redirect back dengan pesan sukses
    Page --> HRD : 2.3 Tampilkan notifikasi "Kategori Berhasil Dibuat"
  else <font color=black>[Gagal: Nama Kategori Duplikat / Kosong]</font>
    Controller --> Page : 2.4 Return redirect back dengan pesan error
    Page --> HRD : 2.5 Tampilkan notifikasi kesalahan input
  end
  deactivate Controller
  deactivate Page
  deactivate HRD
end

' Group sd Update: Ubah Data Kategori
group sd Update
  HRD -> Page : 3. Klik tombol edit, ubah nama kategori, klik "Perbarui"
  activate HRD
  activate Page
  Page -> Controller : 3.1 update(request, id)
  activate Controller
  Controller -> Model : 3.1.1 findOrFail(id)->update(request->all())
  activate Model
  Model --> Controller : 3.1.2 Result status update
  deactivate Model

  alt <font color=black>[Sukses: Pembaruan Valid]</font>
    Controller --> Page : 3.2 Return redirect back dengan pesan sukses
    Page --> HRD : 3.3 Tampilkan notifikasi "Kategori Berhasil Diperbarui"
  else <font color=black>[Gagal: Nama Kategori Tidak Valid]</font>
    Controller --> Page : 3.4 Return redirect back dengan pesan error
    Page --> HRD : 3.5 Tampilkan notifikasi kesalahan pembaruan
  end
  deactivate Controller
  deactivate Page
  deactivate HRD
end

' Group sd Delete: Hapus Kategori
group sd Delete
  HRD -> Page : 4. Klik tombol hapus kategori
  activate HRD
  activate Page
  Page -> Controller : 4.1 destroy(id)
  activate Controller
  Controller -> Model : 4.1.1 findOrFail(id)->delete()
  activate Model
  Model --> Controller : 4.1.2 Result status hapus
  deactivate Model
  Controller --> Page : 4.2 Return redirect back dengan pesan sukses
  deactivate Controller
  Page --> HRD : 4.3 Tampilkan notifikasi kategori berhasil dihapus
  deactivate Page
  deactivate HRD
end

@enduml
