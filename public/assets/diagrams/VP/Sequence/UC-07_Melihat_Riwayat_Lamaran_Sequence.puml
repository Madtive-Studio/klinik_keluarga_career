@startuml UC-07_Melihat_Riwayat_Lamaran_Sequence
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam sequenceParticipantBorderThickness 1
skinparam sequenceLifeLineBorderColor #000000
skinparam sequenceLifeLineBorderThickness 1
skinparam sequenceLifeLineBackgroundColor #7ACFF5
skinparam sequenceGroupBorderThickness 1
skinparam sequenceGroupFontSize 10
skinparam sequenceGroupHeaderFontColor #000000
skinparam sequenceGroupFontColor #000000
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 160
skinparam pageMargin 10
hide footbox

skinparam participant {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 10
}

skinparam boundary {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam control {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam entity {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

' Deklarasi Lifeline
actor "Pelamar" as Pelamar
boundary "ApplicationPage" as Page
control "ApplicationController" as Controller
entity "ApplyModel" as Model

' Group sd View/Read: Memantau Riwayat Lamaran
group sd View/Read
  Pelamar -> Page : 1. Akses menu riwayat lamaran saya
  activate Pelamar
  activate Page
  Page -> Controller : 1.1 index(request)
  activate Controller
  Controller -> Model : 1.1.1 getApplicationsByCandidate(candidateId, filters)
  activate Model
  Model --> Controller : 1.1.2 Result data riwayat lamaran
  deactivate Model

  alt <font color=black>[Sukses: Riwayat Lamaran Ditemukan]</font>
    Controller --> Page : 1.2 Return view("candidate.jobs.applications.index")
    Page --> Pelamar : 1.3 Tampilkan daftar riwayat lamaran & badge status terkini
  else <font color=black>[Gagal / Kosong: Belum Ada Lamaran]</font>
    Controller --> Page : 1.4 Return view dengan daftar lamaran kosong
    Page --> Pelamar : 1.5 Tampilkan notifikasi "Belum Ada Lamaran Diajukan"
  end
  deactivate Controller
  deactivate Page
  deactivate Pelamar
end

@enduml
