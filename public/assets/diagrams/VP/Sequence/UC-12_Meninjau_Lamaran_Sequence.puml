@startuml UC-12_Meninjau_Lamaran_Sequence
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam sequenceParticipantBorderThickness 1
skinparam sequenceLifeLineBorderColor #000000
skinparam sequenceLifeLineBorderThickness 1
skinparam sequenceLifeLineBackgroundColor #7ACFF5
skinparam sequenceGroupBorderThickness 1
skinparam sequenceGroupFontSize 10
skinparam sequenceGroupHeaderFontColor #000000
skinparam sequenceGroupFontColor #000000
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 160
skinparam pageMargin 10
hide footbox

skinparam participant {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 10
}

skinparam boundary {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam control {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

skinparam entity {
  BackgroundColor #7ACFF5
  BorderColor #000000
  FontSize 10
}

' Deklarasi Lifeline
actor "HRD / Admin" as HRD
boundary "ApplicationPage" as Page
control "ApplicantController" as Controller
entity "ApplyModel" as Model

' Group sd View/Read: Akses Daftar Berkas Lamaran
group sd View/Read
  HRD -> Page : 1. Akses menu seleksi berkas lamaran
  activate HRD
  activate Page
  Page -> Controller : 1.1 datatables(request)
  activate Controller
  Controller -> Model : 1.1.1 with(['candidate', 'job', 'batch', 'applyDocuments'])->latest()->get()
  activate Model
  Model --> Controller : 1.1.2 Result data pelamar
  deactivate Model
  Controller --> Page : 1.2 Return JSON DataTables data
  deactivate Controller
  Page --> HRD : 1.3 Tampilkan daftar berkas pelamar
  deactivate Page
  deactivate HRD
end

' Group sd Detail: Pratinjau Dokumen Pelamar
group sd Detail
  HRD -> Page : 2. Klik tombol detail berkas pelamar
  activate HRD
  activate Page
  Page -> Controller : 2.1 show(id)
  activate Controller
  Controller -> Model : 2.1.1 with(['candidate.profile', 'candidate.skills', 'applyDocuments.document'])->findOrFail(id)
  activate Model
  Model --> Controller : 2.1.2 Result rincian berkas lamaran
  deactivate Model
  Controller --> Page : 2.2 Return view("admin.applies.detail")
  deactivate Controller
  Page --> HRD : 2.3 Tampilkan resume & berkas CV, STR pelamar
  deactivate Page
  deactivate HRD
end

' Group sd Update: Pembaruan Status Lamaran
group sd Update
  HRD -> Page : 3. Tentukan status kelulusan (SHORTLISTED / NOT SUITABLE), klik "Simpan Status"
  activate HRD
  activate Page
  Page -> Controller : 3.1 update(request, id)
  activate Controller
  Controller -> Model : 3.1.1 findOrFail(id)->update(['status' => request->status])
  activate Model
  Model --> Controller : 3.1.2 Result status update
  deactivate Model

  alt <font color=black>[Status SHORTLISTED: Memenuhi Syarat]</font>
    Controller -> Controller : 3.2 candidate->notify(new ApplicationStatusUpdatedNotification)
    Controller --> Page : 3.3 Return redirect route("admin.applies.index") dengan pesan sukses
    Page --> HRD : 3.4 Tampilkan notifikasi status kandidat lolos seleksi berkas
  else <font color=black>[Status NOT SUITABLE: Berkas Tidak Sesuai]</font>
    Controller -> Controller : 3.5 candidate->notify(new ApplicationStatusUpdatedNotification)
    Controller --> Page : 3.6 Return redirect route("admin.applies.index") dengan pesan sukses
    Page --> HRD : 3.7 Tampilkan notifikasi status kandidat tidak lolos kualifikasi
  end
  deactivate Controller
  deactivate Page
  deactivate HRD
end

@enduml
