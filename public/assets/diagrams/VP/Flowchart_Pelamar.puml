@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #2F55D4
  DiamondBackgroundColor #FEF3E2
  DiamondBorderColor #D97706
}
skinparam ArrowColor #2F55D4

title Flowchart Alur Pendaftaran Akun & Pengajuan Lamaran (Pelamar)

|Bagian 1: Registrasi & Login Akun|
start
:Akses Halaman Utama Portal Karir;

if (Sudah Memiliki Akun?) then (Belum)
  :Isi Formulir Registrasi Akun;
  :Sistem Kirim Email Token Aktivasi;
  :Buka Email & Klik Verifikasi;
  :Akun Terverifikasi & Aktif;
else (Sudah)
endif

:Login ke Portal Pelamar;
(A)
detach

|Bagian 2: Pengajuan Lamaran & Auto-Scoring|
(A)
:Lengkapi Profil & Unggah Berkas (CV, STR);
:Eksplorasi Katalog Lowongan pada Batch Aktif;
:Pilih Posisi Lowongan & Buka Detail;

if (Syarat & Berkas Lengkap?) then (Tidak)
  :Perbaiki / Lengkapi Berkas;
else (Ya)
endif

:Isi Cover Letter & Pilih Lampiran;
:Klik Tombol "Lamar Sekarang";
:Sistem Simpan Lamaran & Jalankan Auto-Scoring (1-100);
:Sistem Kirim Email Konfirmasi Lamaran;
:Pelamar Pantau Status di "Lamaran Saya";
stop

@enduml