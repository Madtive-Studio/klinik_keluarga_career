@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #2F55D4
  DiamondBackgroundColor #FEF3E2
  DiamondBorderColor #D97706
}
skinparam ArrowColor #2F55D4

title Flowchart Alur Peninjauan Lamaran & Penjadwalan Wawancara (Admin HRD)

|Bagian 1: Peninjauan Lamaran Masuk|
start
:Akses Halaman Login Admin HRD;
:Autentikasi Kredensial Akun HRD;
:Buka Dashboard Manajemen Rekrutmen;
:Kelola Master Data (Batch & Lowongan);
:Buka Halaman Review Berkas Lamaran;
:Sistem Tampilkan Pelamar Terurut Auto-Score;
:HRD Meninjau Profil & Berkas (CV/STR);
(B)
detach

|Bagian 2: Seleksi & Penjadwalan Wawancara|
(B)
if (Hasil Seleksi Berkas?) then (Memenuhi Syarat)
  :Ubah Status: "SHORTLISTED";
  :Sistem Kirim Email Notifikasi Shortlisted;
  :Buka Menu Penjadwalan Wawancara;
  :Pilih Kandidat Shortlisted (SlimSelect);
  :Atur Tanggal, Jam, Tipe (Online/Offline) & Lokasi/Link;
  :Simpan Jadwal Wawancara;
  :Sistem Otomatis Kirim Undangan Wawancara;
else (Tidak Memenuhi)
  :Ubah Status: "NOT SUITABLE / REJECT";
  :Sistem Kirim Email Notifikasi Penolakan;
endif

stop

@enduml