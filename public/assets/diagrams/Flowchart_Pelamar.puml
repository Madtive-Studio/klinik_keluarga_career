@startuml
skinparam handwritten false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #2F55D4
  DiamondBackgroundColor #FEF3E2
  DiamondBorderColor #D97706
}
skinparam ArrowColor #2F55D4

title Flowchart Alur Pendaftaran Akun & Pengajuan Lamaran (Pelamar)

start
:Akses Halaman Utama Portal Karir Klinik Keluarga;

if (Sudah Memiliki Akun?) then (Belum)
  :Isi Formulir Registrasi Akun Pelamar;
  :Sistem Mengirim Email Token Aktivasi;
  :Buka Email & Klik Tautan Verifikasi;
  :Akun Terverifikasi & Aktif;
else (Sudah)
endif

:Login ke Portal Pelamar (Email & Password);
:Lengkapi Profil (Biodata, Pendidikan, Pengalaman, Keahlian);
:Unggah Dokumen Digital (CV, Ijazah, STR, Sertifikat);

:Eksplorasi Katalog Lowongan pada Gelombang (Batch) Aktif;
:Pilih Posisi Lowongan & Buka Halaman Detail;

if (Kandidat Memenuhi Syarat Minimal?) then (Tidak)
  :Sistem Tampilkan Peringatan Syarat Belum Terpenuhi;
  :Lengkapi Persyaratan Dokumen / Profil;
else (Ya)
endif

:Isi Surat Lamaran (Cover Letter);
:Pilih Dokumen Lampiran yang Relevan;
:Klik Tombol "Lamar Sekarang";

:Sistem Menyimpan Lamaran ke Basis Data;
:Auto-Scoring Engine Menghitung Skor Kelayakan (1-100);
:Sistem Mengirim Notifikasi Email Konfirmasi Pengajuan Lamaran;
:Tampil Halaman Konfirmasi Sukses;
:Pelamar Memantau Status Lamaran pada Menu "Lamaran Saya";

stop
@enduml