@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #2F55D4
  DiamondBackgroundColor #FEF3E2
  DiamondBorderColor #D97706
}
skinparam ArrowColor #2F55D4

title Flowchart Alur Peninjauan Lamaran & Penjadwalan Wawancara (Admin HRD)

start
:Akses Halaman Login Admin HRD;
:Autentikasi Kredensial Akun HRD;

:Buka Dashboard Manajemen Rekrutmen;
:Kelola Master Data (Gelombang/Batch, Kategori & Lowongan);

:Buka Halaman Review Berkas Lamaran Masuk;
:Sistem Menampilkan Pelamar Terurut Berdasarkan Skor Kelayakan (Auto-Score);
:HRD Meninjau Rincian Profil & Berkas Dokumen (CV/STR);

if (Hasil Penilaian Administrasi & Kualifikasi?) then (Memenuhi Syarat)
  :Ubah Status Lamaran Menjadi "SHORTLISTED";
  :Sistem Mengirim Email Notifikasi Status Shortlisted;
  
  :Buka Menu Penjadwalan Wawancara (Schedule Interview);
  :Pilih Kandidat Shortlisted menggunakan SlimSelect;
  :Tentukan Tanggal, Jam Mulai & Jam Selesai;
  
  if (Jenis Wawancara?) then (Online)
    :Input Tautan Virtual (Zoom / Google Meet);
  else (Offline)
    :Input Lokasi Ruangan / Alamat Klinik;
  endif
  
  :Input Catatan & Deskripsi Wawancara;
  :Simpan Jadwal Wawancara;
  :Sistem Otomatis Mengirim Email Undangan Wawancara Resmi ke Kandidat;
else (Tidak Memenuhi)
  :Ubah Status Lamaran Menjadi "NOT SUITABLE / REJECTED";
  :Sistem Mengirim Email Notifikasi Pembaruan Status;
endif

stop
@enduml