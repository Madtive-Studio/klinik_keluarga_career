@startuml
skinparam handwritten false
skinparam monochrome false
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #2F55D4
}
skinparam component {
  BackgroundColor #E8F4FD
  BorderColor #0D6EFD
}
skinparam artifact {
  BackgroundColor #FEF3E2
  BorderColor #D97706
}
skinparam database {
  BackgroundColor #FEF3E2
  BorderColor #D97706
}

title Deployment Diagram Sistem E-Recruitment Klinik Keluarga

node "Client Device\n<<device>>\n(PC / Laptop / Smartphone)" as Client {
  node "Web Browser\n<<executionEnvironment>>" as Browser {
    component "Web Interface UI\n(HTML5, CSS3, Bootstrap 5, JS, SlimSelect)" as WebUI
  }
}

node "Application & Web Server\n<<device>>\n(Ubuntu Linux 24.04 LTS)" as AppServer {
  node "Web Server\n<<executionEnvironment>>\n(Nginx / Apache)" as WebServer {
    component "HTTP Handler / Reverse Proxy" as Proxy
  }
  
  node "PHP 8.2 Runtime\n<<executionEnvironment>>" as PHPEnv {
    component "Laravel 11 Framework Core" as LaravelCore
    component "Auto-Scoring Engine\n(ScoringService)" as ScoringEngine
    component "Notification & Mailer Subsystem" as MailerSubsystem
    component "Eloquent ORM" as Eloquent
  }
  
  artifact "Local Storage File System\n(/storage/app/public/)\n[PDF CV, Ijazah, STR]" as Storage
}

node "Database Server\n<<device>>\n(Linux Server)" as DBServer {
  node "PostgreSQL 16 DBMS\n<<executionEnvironment>>" as PGEnv {
    database "klinik_keluarga_career\n[15 Relational Tables]" as Database
  }
}

node "External Mail Gateway\n<<device>>" as MailServer {
  node "SMTP Service\n<<executionEnvironment>>" as SMTPEnv {
    component "Gmail SMTP Server\n(smtp.gmail.com)" as GmailSMTP
  }
}

' Relations
Client -- AppServer : "HTTPS (Port 443)\nTCP/IP Network"
Proxy ..> LaravelCore : "PHP-FPM / FastCGI"
LaravelCore ..> ScoringEngine
LaravelCore ..> MailerSubsystem
LaravelCore ..> Eloquent
LaravelCore --> Storage : "Read / Write I/O"

AppServer -- DBServer : "PostgreSQL Protocol (Port 5432)\nTCP/IP Connection"
Eloquent --> Database : "PDO SQL Queries"

AppServer -- MailServer : "SMTP over TLS (Port 587)"
MailerSubsystem --> GmailSMTP : "Transactional Emails"

@enduml
